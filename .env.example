# Factor Lab environment template.
# Copy to .env.local (git-ignored) and fill in real values. Never commit secrets.

# --- Flask API port contract -------------------------------------------------
# Local development reserves port 8012 for the Factor Lab API.
# On Render (or another cloud host) the platform injects $PORT automatically;
# backend/factor_lab_api.py reads PORT with 8012 as the local default, so no
# code change is needed when deploying. Do not hard-code a cloud port here.
PORT=8012
HOST=127.0.0.1

# Base URL the dashboard / CLI should talk to. Leave unset for local default
# (http://127.0.0.1:8012). In production set it to the deployed API, e.g.
# FACTOR_LAB_API_HOST=https://factor-lab-api.onrender.com
FACTOR_LAB_API_HOST=

# Browser origin allowed by CORS on the API (GitHub Pages host of the dashboard).
FACTOR_LAB_PUBLIC_ORIGIN=https://miao050805-arch.github.io

# --- Supabase (cloud database) ----------------------------------------------
# Project URL, e.g. https://<project-ref>.supabase.co
FACTOR_LAB_SUPABASE_URL=
# service_role key used ONLY by trusted backend/local sync scripts
# (scripts/sync_truth_compare_to_supabase.py). Never expose it in the browser;
# the static dashboard only uses the anon publishable key in config.js.
FACTOR_LAB_SUPABASE_WRITE_KEY=

# Optional: directory with library standard truth files (<factor_name>.csv)
# used by scripts/run_truth_compare.py when a submission does not embed
# truth_values.csv and --library-truth-dir is not passed.
FACTOR_LAB_TRUTH_DIR=

# --- Quant data API (existing backend integration) ---------------------------
FACTOR_LAB_QUANT_API_TOKEN=
